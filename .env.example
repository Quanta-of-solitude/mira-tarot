# Copy to .env.local for local use; add the same values in Vercel > Project > Settings > Environment Variables.

# ---- Sign-in ----
# Any long random string. Generate one with: npx auth secret
AUTH_SECRET=

# ---- Email for sign-in codes (any SMTP account) ----
# Gmail: turn on 2-step verification, then create an app password at
# https://myaccount.google.com/apppasswords and paste its 16 characters below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Optional. Defaults to "Mira's Tarot Room <SMTP_USER>"
EMAIL_FROM=

# ---- Database (Neon Postgres, via Vercel Storage) ----
DATABASE_URL=

# ---- Payments: Cashfree (individual sign-up with personal PAN) ----
# Dashboard > Developers > API Keys. Use the Test keys with CASHFREE_ENV=sandbox first.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# sandbox or production
CASHFREE_ENV=sandbox
# Optional. Public https address of the site, for testing payments through a tunnel to localhost.
# Not needed on Vercel.
APP_URL=

# ---- Payments: Razorpay (optional alternative) ----
# PAYMENT_PROVIDER=razorpay to use it when both are configured.
PAYMENT_PROVIDER=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Readings (Claude API) ----
ANTHROPIC_API_KEY=
# Optional. Default claude-opus-5-5. claude-haiku-5-5 is far cheaper per reading.
READING_MODEL=

# ---- You ----
# Comma-separated emails that get unlimited readings and the test tools
ADMIN_EMAILS=
# Secret key (at least 16 characters) for "I have an admin key" sign-in. Lets you in without email set up.
# Generate one with: openssl rand -hex 16
ADMIN_KEY=
NEXT_PUBLIC_SUPPORT_EMAIL=
